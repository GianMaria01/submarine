{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compila Raylib per debug",
            "type": "shell",
            "command": "mingw32-make -f Compilatore.mak all",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:\\w64devkit\\bin;${env:PATH}"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Compila e Avvia raylib",
            "type": "shell",
            "command": "mingw32-make -f Compilatore.mak run",
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "C:\\w64devkit\\bin;${env:PATH}"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": "$gcc"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe compila il file attivo",
            "command": "C:/w64devkit/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "C:/w64devkit/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Attività generata dal debugger."
        }
    ]
}